<?xml version="1.0" encoding="UTF-8"?>
<!--
  Construction Progress Portal | v14.1.0
  Place at:  <docroot>\status\web.config   — the /status/ FOLDER ONLY.

  <clear /> is deliberate and load-bearing.

  Without it, this file returns:
      HTTP Error 500.19 — Cannot add duplicate collection entry of type 'add'
      with unique key attribute 'value' set to 'index.php'
  on any host whose parent configuration ALREADY lists index.php as a default
  document. The defaultDocument <files> collection is inherited and keyed on
  'value', so adding an entry that already exists is a hard configuration error
  — and a configuration error takes out the whole folder, static files included.

  <clear /> drops whatever is inherited and states exactly what this folder
  wants, which is deterministic on every host: index.php and nothing else.
  That is correct here regardless of the parent, because /status/ is a PHP app.

  Everything else is left out on purpose. On Plesk, <httpCompression> is not
  delegable at all, and <httpErrors> and removeServerHeader are usually locked;
  any of them returns 500.19 for the entire folder. Content-Security-Policy is
  sent by index.php and admin_backend.php — browsers enforce the INTERSECTION of
  every CSP header, so a second one here could only make it stricter.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
