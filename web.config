<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <system.webServer>
        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />

            <remove fileExtension=".avif" />
            <mimeMap fileExtension=".avif" mimeType="image/avif" />

            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />

            <remove fileExtension=".svgz" />
            <mimeMap fileExtension=".svgz" mimeType="image/svg+xml" />

            <remove fileExtension=".heic" />
            <mimeMap fileExtension=".heic" mimeType="image/heic" />

            <remove fileExtension=".heif" />
            <mimeMap fileExtension=".heif" mimeType="image/heif" />

            <remove fileExtension=".png" />
            <mimeMap fileExtension=".png" mimeType="image/png" />

            <remove fileExtension=".jpg" />
            <mimeMap fileExtension=".jpg" mimeType="image/jpeg" />

            <remove fileExtension=".jpeg" />
            <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />

            <remove fileExtension=".jfif" />
            <mimeMap fileExtension=".jfif" mimeType="image/jpeg" />

            <remove fileExtension=".gif" />
            <mimeMap fileExtension=".gif" mimeType="image/gif" />

            <remove fileExtension=".ico" />
            <mimeMap fileExtension=".ico" mimeType="image/x-icon" />

            <remove fileExtension=".cur" />
            <mimeMap fileExtension=".cur" mimeType="image/x-icon" />

            <remove fileExtension=".bmp" />
            <mimeMap fileExtension=".bmp" mimeType="image/bmp" />

            <remove fileExtension=".tif" />
            <mimeMap fileExtension=".tif" mimeType="image/tiff" />

            <remove fileExtension=".tiff" />
            <mimeMap fileExtension=".tiff" mimeType="image/tiff" />

            <remove fileExtension=".apng" />
            <mimeMap fileExtension=".apng" mimeType="image/apng" />

            <remove fileExtension=".jxl" />
            <mimeMap fileExtension=".jxl" mimeType="image/jxl" />

            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />

            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

            <remove fileExtension="." />
            <mimeMap fileExtension="." mimeType="application/octet-stream" />
            <!-- Cache static assets 7 days (PageSpeed: efficient cache lifetimes) -->
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>

        <!-- Enable dynamic/static compression when IIS module is available -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <rewrite>
            <rules>
                <rule name="RC Media Images Gateway" stopProcessing="true">
                    <match url="^images/(.+)$" />
                    <action type="Rewrite" url="media_serve.php?f={R:1}" appendQueryString="true" />
                </rule>

                
                <rule name="PublicImagesGateway" stopProcessing="true">
                    <match url="^images/(.+)$" />
                    <action type="Rewrite" url="media_serve.php?f={R:1}" appendQueryString="true" />
                </rule>

                <rule name="SitemapXML" stopProcessing="true">
                    <match url="^sitemap.xml$" />
                    <action type="Rewrite" url="sitemap.php" />
                </rule>

                <!-- Dynamic robots.txt with absolute Sitemap URL for current host -->
                <rule name="RobotsTxtDynamic" stopProcessing="true">
                    <match url="^robots.txt$" />
                    <action type="Rewrite" url="robots.php" />
                </rule>

                <rule name="Redirect Tools Directory" stopProcessing="true">
                    <match url="^(monitor|optimizer|print)\.php$" />
                    <action type="Redirect" url="tools/{R:1}.php" redirectType="Permanent" />
                </rule>

                <rule name="Clean Profile URL" stopProcessing="true">
                    <match url="^([a-zA-Z0-9\-_]+)$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_URI}" pattern="^/(sitemap\.php|sitemap\.xml|robots\.txt|manifest\.php)$" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php?slug={R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="dbd" />
                    <add segment="data" />
                    <add segment="tenants" />
                    <add segment="app" />
                    <add segment="storage" />
                    <add segment="sql" />
                    <add segment="tests" />
                    <add segment="docs" />
                </hiddenSegments>
                <fileExtensions>
                    <add fileExtension=".json" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>
