{
  "exact": {
    "rc.fusionlimited.in": "fusionlimited",
    "www.rc.fusionlimited.in": "fusionlimited",
    "rc.arthsathi.com": "arthsathi",
    "www.rc.arthsathi.com": "arthsathi",
    "rc.digisofts.com": "digisofts",
    "www.rc.digisofts.com": "digisofts",
    "rc.simcoauto.com": "simcoauto",
    "www.rc.simcoauto.com": "simcoauto",
    "simcoauto.com": "simcoauto",
    "www.simcoauto.com": "simcoauto",
    "rc.dhruvkhandelwal.in": "dhruvkhandelwal",
    "www.rc.dhruvkhandelwal.in": "dhruvkhandelwal"
  },
  "rules": [
    {
      "match": "/^rc\\.([a-z0-9][a-z0-9-]{0,62})\\./i",
      "group": 1,
      "comment": "rc.{tenant}.tld — wildcard for any new rc.* host"
    },
    {
      "match": "/^([a-z0-9][a-z0-9-]{0,62})\\.rc\\./i",
      "group": 1,
      "comment": "{tenant}.rc.tld"
    }
  ],
  "fallback": "default",
  "notes": "Hostnames never redirect between tenants. rc.simcoauto.com stays on simcoauto data path tenants/simcoauto/data/ Set strict_hosts true to allow only exact map hosts.",
  "strict_hosts": false
}
